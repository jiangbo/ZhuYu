--- !tapi-tbd
tbd-version: 4
targets: ["arm64-macos", "x86_64-macos"]
install-name: "/System/Library/Frameworks/AudioToolbox.framework/Versions/A/AudioToolbox"
current-version: 1000
exports:
  - targets: ["arm64-macos"]
    symbols: ["_AudioQueueAllocateBuffer", "_AudioQueueDispose",
                     "_AudioQueueEnqueueBuffer", "_AudioQueueNewOutput",
                     "_AudioQueueStart", "_AudioQueueStop"]
  - targets: ["x86_64-macos"]
    symbols: ["_AudioQueueAllocateBuffer", "_AudioQueueDispose",
                     "_AudioQueueEnqueueBuffer", "_AudioQueueNewOutput",
                     "_AudioQueueStart", "_AudioQueueStop"]
...
