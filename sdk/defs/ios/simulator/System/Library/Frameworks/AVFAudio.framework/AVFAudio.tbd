--- !tapi-tbd
tbd-version: 4
targets: ["arm64-ios-simulator", "x86_64-ios-simulator"]
install-name: "/System/Library/Frameworks/AVFAudio.framework/AVFAudio"
exports:
  - targets: ["arm64-ios-simulator"]
    symbols: ["_AVAudioSessionCategoryPlayback",
                     "_AVAudioSessionInterruptionNotification",
                     "_AVAudioSessionInterruptionTypeKey"]
    objc-classes: ["AVAudioSession"]
  - targets: ["x86_64-ios-simulator"]
    symbols: ["_AVAudioSessionCategoryPlayback",
                     "_AVAudioSessionInterruptionNotification",
                     "_AVAudioSessionInterruptionTypeKey"]
    objc-classes: ["AVAudioSession"]
...
