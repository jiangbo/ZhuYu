--- !tapi-tbd
tbd-version: 4
targets: ["arm64-ios-simulator", "x86_64-ios-simulator"]
install-name: "/System/Library/Frameworks/AudioToolbox.framework/AudioToolbox"
current-version: 1000
exports:
  - targets: ["arm64-ios-simulator"]
    symbols: ["_AudioQueueAllocateBuffer", "_AudioQueueDispose",
                     "_AudioQueueEnqueueBuffer", "_AudioQueueNewOutput",
                     "_AudioQueuePause", "_AudioQueueStart", "_AudioQueueStop"]
  - targets: ["x86_64-ios-simulator"]
    symbols: ["_AudioQueueAllocateBuffer", "_AudioQueueDispose",
                     "_AudioQueueEnqueueBuffer", "_AudioQueueNewOutput",
                     "_AudioQueuePause", "_AudioQueueStart", "_AudioQueueStop"]
...
